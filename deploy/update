#!/usr/bin/env bash
# Installed as /usr/local/bin/update, ahead of /usr/bin/update in PATH. The community-scripts entrypoint in
# /usr/bin/update drops its arguments and is regenerated by the engine, so `update --rollback` is handled here:
# a rollback is local and needs nothing from the network.
if [[ "${1:-}" == "--rollback" ]]; then
  exec bash /opt/auto-dev/current/deploy/auto-dev-update.sh rollback
fi
exec /usr/bin/update "$@"
