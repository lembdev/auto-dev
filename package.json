{
  "name": "auto-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Autonomous development installation on top of Claude Code: orchestrator, driver and web UI",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
